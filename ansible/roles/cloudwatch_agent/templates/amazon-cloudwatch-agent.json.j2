{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/audit/audit.log",
            "log_group_name": "{{ cloudwatch_agent_log_group }}/audit",
            "log_stream_name": "{instance_id}",
            "retention_in_days": {{ cloudwatch_agent_retention_days }}
          },
          {
            "file_path": "/var/log/aws/codedeploy-agent/codedeploy-agent.log",
            "log_group_name": "{{ cloudwatch_agent_log_group }}/codedeploy",
            "log_stream_name": "{instance_id}",
            "retention_in_days": {{ cloudwatch_agent_retention_days }}
          }
        ]
      },
      "journald": {
        "collect_list": [
          {
            "units": ["{{ cloudwatch_agent_app }}.service"],
            "log_group_name": "{{ cloudwatch_agent_log_group }}/app",
            "log_stream_name": "{instance_id}",
            "retention_in_days": {{ cloudwatch_agent_retention_days }}
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "App/{{ cloudwatch_agent_app }}",
    "append_dimensions": { "AutoScalingGroupName": "${aws:AutoScalingGroupName}", "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  }
}
