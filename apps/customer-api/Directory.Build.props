<Project>
  <!-- Shared settings for every project in this app -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lock files make dependency versions reproducible and let Trivy scan them (SCA) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- NuGet audit: known-vulnerable packages show up as build warnings -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
